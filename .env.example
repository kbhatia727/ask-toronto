# Copy this file to ".env.local" and fill in your own keys.
# .env.local is gitignored — never commit real keys.

# Embeddings (turning text into vectors for dataset matching).
# Get a free key at https://aistudio.google.com/apikey  (starts with "AIza...")
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key

# Chat / agent model. Get a free key at https://console.groq.com  (starts with "gsk_...")
GROQ_API_KEY=your_groq_key

# Local infrastructure (started via `docker compose up -d`).
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://toronto:toronto@localhost:5432/torontoai
